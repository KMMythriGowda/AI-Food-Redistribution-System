# Copy to .env before Docker Compose or local development.
PORT=5000
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production-12345
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production-67890
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Docker/local PostgreSQL password is intentionally consistent across example files.
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/food_redistribution_db

# Production Docker frontend calls same-origin /api through Nginx.
VITE_API_BASE_URL=/api
FRONTEND_URL=http://localhost
CORS_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:3000

# AI microservice
AI_SERVICE_URL=http://127.0.0.1:8000
AI_DAILY_JOB_HOUR=2
AI_DAILY_JOB_MINUTE=0
AI_WEEKLY_JOB_DAY=monday
AI_WEEKLY_JOB_HOUR=3
AI_WEEKLY_JOB_MINUTE=0
AI_MONTHLY_JOB_DAY=1
AI_MONTHLY_JOB_HOUR=4
AI_MONTHLY_JOB_MINUTE=0

# NGO verification/admin demo bootstrap
AUTO_VERIFY_NGO=false
BOOTSTRAP_ADMIN_EMAIL=admin@foodredistribution.org
BOOTSTRAP_ADMIN_PASSWORD=AdminPass123!
BOOTSTRAP_ADMIN_NAME=System Administrator

# Geocoding: common Indian cities work offline; enable this for other addresses via Nominatim.
ENABLE_GEOCODING=false

# Optional SMTP. In development, if SMTP is blank, forgot-password returns a local reset link.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
PASSWORD_RESET_EXPIRES_SECONDS=1800
PASSWORD_RESET_RETURN_LINK=true
